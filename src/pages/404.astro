---
import Base from "../layouts/Base.astro";
import { site } from "../site";
---

<Base title={`Page not found — ${site.name}`}>
  <main>
    <p class="eyebrow">404</p>
    <h1>This page doesn't exist.</h1>
    <p><a href="/">Back to {site.name}</a></p>
  </main>
</Base>

<style>
  main {
    max-width: 44rem;
    margin: 0 auto;
    padding: clamp(4rem, 14vh, 9rem) 16px;
    text-align: center;
  }
  .eyebrow {
    font-size: 0.8rem;
    letter-spacing: 0.18em;
    color: var(--muted);
  }
  h1 {
    font-family: var(--display);
    font-size: 2.6rem;
    font-weight: 600;
  }
</style>
