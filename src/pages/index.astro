---
import { getCollection, render } from "astro:content";
import Base from "../layouts/Base.astro";
import { site } from "../site";

const books = (await getCollection("books", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.order - a.data.order,
);
const rendered = await Promise.all(books.map(async (book) => ({ book, ...(await render(book)) })));

const linkLabels: Record<string, string> = {
  instagram: "Instagram",
  goodreads: "Goodreads",
  amazon: "Amazon",
};
const links = Object.entries(site.links).filter(([, url]) => url);
---

<Base>
  <header class="hero">
    <p class="eyebrow">{site.tagline}</p>
    <h1>{site.name}</h1>
    <p class="intro">{site.intro}</p>
    <nav>
      <a href="#about">About</a>
      {rendered.length > 0 && <a href="#books">Books</a>}
      {site.email && <a href="#contact">Contact</a>}
    </nav>
  </header>

  <main>
    <section id="about" class="about">
      {site.photo && <img class="photo" src={site.photo} alt={`Portrait of ${site.name}`} />}
      <div>
        <h2>About</h2>
        {site.about.map((p) => <p>{p}</p>)}
      </div>
    </section>

    {
      rendered.length > 0 && (
        <section id="books">
          <h2>Books</h2>
          <ul class="books">
            {rendered.map(({ book, Content }) => (
              <li class="book">
                {book.data.cover && (
                  <img class="cover" src={book.data.cover} alt={`Cover of ${book.data.title}`} />
                )}
                <div>
                  {book.data.status && <p class="status">{book.data.status}</p>}
                  <h3>{book.data.title}</h3>
                  {book.data.subtitle && <p class="subtitle">{book.data.subtitle}</p>}
                  <Content />
                  {book.data.buyUrl && (
                    <a class="buy" href={book.data.buyUrl}>
                      Get the book →
                    </a>
                  )}
                </div>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      site.email && (
        <section id="contact">
          <h2>Contact</h2>
          <p>
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </p>
        </section>
      )
    }
  </main>

  <footer>
    {
      links.length > 0 && (
        <p class="links">
          {links.map(([key, url]) => (
            <a href={url}>{linkLabels[key] ?? key}</a>
          ))}
        </p>
      )
    }
    <p>© {new Date().getFullYear()} {site.name}</p>
  </footer>
</Base>

<style>
  .hero, main, footer {
    max-width: 44rem;
    margin: 0 auto;
    padding: 0 16px;
  }
  .hero {
    padding-top: clamp(4rem, 14vh, 9rem);
    padding-bottom: 3rem;
    text-align: center;
    border-bottom: 1px solid var(--rule);
  }
  .eyebrow, .status {
    font-size: 0.8rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0;
  }
  h1, h2, h3 {
    font-family: var(--display);
    font-weight: 600;
    line-height: 1.1;
  }
  h1 {
    font-size: clamp(3rem, 11vw, 5.5rem);
    margin: 0.3rem 0 0.8rem;
  }
  .intro {
    font-family: var(--display);
    font-style: italic;
    font-size: 1.45rem;
    color: var(--muted);
    margin: 0 auto;
    max-width: 30rem;
  }
  nav {
    margin-top: 2rem;
    display: flex;
    justify-content: center;
    gap: 1.75rem;
  }
  nav a {
    color: var(--ink);
    text-decoration: none;
    font-size: 0.95rem;
    letter-spacing: 0.04em;
  }
  nav a:hover { color: var(--accent); }
  section {
    padding: 3.5rem 0;
    border-bottom: 1px solid var(--rule);
  }
  h2 {
    font-size: 2.2rem;
    margin: 0 0 1.25rem;
  }
  .about {
    display: grid;
    gap: 2rem;
    align-items: start;
  }
  .photo {
    width: 100%;
    max-width: 14rem;
    border-radius: 4px;
  }
  @media (min-width: 640px) {
    .about:has(.photo) { grid-template-columns: 14rem 1fr; }
  }
  .books {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 3rem;
  }
  .book {
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 640px) {
    .book:has(.cover) { grid-template-columns: 10rem 1fr; }
  }
  .cover {
    width: 10rem;
    box-shadow: 0 6px 18px rgb(0 0 0 / 0.18);
  }
  h3 {
    font-size: 1.9rem;
    margin: 0.25rem 0 0.5rem;
  }
  .subtitle {
    font-style: italic;
    color: var(--muted);
    margin-top: 0;
  }
  .buy {
    font-weight: 600;
    text-decoration: none;
  }
  footer {
    padding-top: 2.5rem;
    padding-bottom: 3rem;
    text-align: center;
    color: var(--muted);
    font-size: 0.9rem;
  }
  .links {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
  }
</style>
